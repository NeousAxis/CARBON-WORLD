# CARBON WORLD Worker configuration (optional overrides — sensible defaults exist)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:32b
OLLAMA_TIMEOUT_SECONDS=240
OLLAMA_REPEAT_PENALTY=1.15

MAX_ARTICLES_PER_RUN=20
MIN_HOURS_BETWEEN_RUNS=6

# Per-source cap applied BEFORE round-robin interleave.
# Prevents mainstream sources from dominating the article list.
# Guardian 50 articles/run -> 3 kept. Niche sources with <3 articles are unaffected.
MAX_PER_SOURCE_PER_RUN=3

# Optional: override the SQLite database path (default: <project>/data/carbon.db)
# DB_PATH=/absolute/path/to/carbon.db

# Semantic deduplication cache (Phase 3, 2026-04-20).
# Reduces LLM quota usage by reusing verdicts for semantically similar articles
# already scored in the last SEMANTIC_CACHE_DAYS days (e.g. 5 sources covering
# the same EU regulation all score only once).  Uses all-MiniLM-L6-v2 (~25 MB,
# ~100 MB RAM, ~50 ms/article CPU) — no GPU required.
# Set SEMANTIC_CACHE_ENABLED=0 to disable entirely (useful for debugging).
# SEMANTIC_CACHE_ENABLED=1
# SEMANTIC_CACHE_DAYS=7
# SEMANTIC_CACHE_THRESHOLD=0.92
# SEMANTIC_MODEL_NAME=all-MiniLM-L6-v2

# Transactional email (OTP login codes). NEVER put a real password here:
# this file is committed to a public repository. Real values live only in
# web/.env.local on the VPS, which is gitignored.
SMTP_USER=hello@example.com
SMTP_PASSWORD=CHANGE_ME
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587