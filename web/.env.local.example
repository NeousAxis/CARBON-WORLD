# ─────────────────────────────────────────────────────────────────────────────
# CARBON WORLD — environment variables for the Next.js web app
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────

# Signs the JWT session cookie and challenge tokens.
# Must be 32+ random characters. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Gates the /review/setup registration page.
# Generate with: openssl rand -base64 32
# DELETE this env var (or set it empty) after you have registered your passkey.
SETUP_SECRET=

# Base64-encoded JSON blob of the registered WebAuthn credential.
# Empty on first deploy — filled in after you run /review/setup.
# Format: base64( JSON({ id, publicKey, counter, transports }) )
# NOTE: publicKey inside the JSON is itself base64-encoded (not base64url).
PASSKEY_CREDENTIAL=

# Relying Party ID — must match the domain shown in the browser address bar.
# Use "localhost" for local development.
# Use "carbon-token.xyz" (or your actual domain) in production.
RP_ID=localhost

# Relying Party Origin — full origin including protocol and port.
# Must exactly match what the browser sends; WebAuthn will reject mismatches.
# Dev:  http://localhost:3000
# Prod: https://carbon-token.xyz
RP_ORIGIN=http://localhost:3000
